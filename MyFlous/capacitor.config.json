{
  "appId": "com.myflous.app",
  "appName": "My Flous",
  "webDir": ".",
  "bundledWebRuntime": false,
  "backgroundColor": "#0A0A0C",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0A0A0C",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0A0A0C",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
